# JARVIS-MK37 Environment Configuration Template
# ================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it contains secrets)

# ── 1. Model Provider Keys ──
# Google Gemini API Key (Fallback and multimodal agent)
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter API Key (Optional: for DeepSeek-R1, Qwen3-Coder remote, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Zhipu AI API Key (Optional: for GLM-4.5 / GLM-5 remote models)
ZHIPU_API_KEY=your_zhipu_api_key_here

# Ollama Local Service URL (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ── 2. Specialist Agents Model Overrides (Optional) ──
# If not specified, agents will use default candidate models or available local Ollama models:
# AGENT_BACKEND_MODEL=qwen3.5:latest
# AGENT_CYBER_MODEL=deepseek/deepseek-r1:free
# AGENT_KERNEL_MODEL=kimi-k2
# AGENT_DATA_MODEL=gemma4:latest
# AGENT_CREATIVE_MODEL=mistral-small
# AGENT_AUTOMATION_MODEL=glm-4.5-air

# ── 3. System & Execution Settings ──
OS_SYSTEM=mac          # mac, windows, or linux
DEBUG=false            # true for verbose logging
LOG_LEVEL=INFO         # DEBUG, INFO, WARNING, ERROR
API_TIMEOUT=30         # seconds
MAX_RETRIES=3          # number of retries on failure
RATE_LIMIT_DELAY=2     # seconds between API calls

# ── 4. Audio settings (Optional) ──
AUDIO_SAMPLE_RATE=16000  # Hz
AUDIO_CHANNELS=1         # mono
