FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc-multilib \
    clang \
    grub-pc-bin \
    grub-common \
    xorriso \
    qemu-system-x86 \
    mtools \
    dosfstools \
    python3 \
    python3-pip \
    curl \
    git \
    make \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["/bin/bash", "-c", "make check-env && make test && make iso && make verify-qemu"]
